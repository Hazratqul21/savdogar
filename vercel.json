{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/health(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/docs(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/verify/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "backend/api/index.py"
    }
  ]
}
