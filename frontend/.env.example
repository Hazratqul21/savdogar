# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# REQUIRED: Backend API URL
# For local development: http://localhost:8000
# For production: https://your-backend.vercel.app (or your deployed backend URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# OPTIONAL: Supabase Configuration (for Global Catalog features)
# Get these from your Supabase project dashboard: https://app.supabase.com/project/_/settings/api
# If not set, Global Catalog features will be disabled (app will still work)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
