{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "frontend/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/verify/(.*)",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/health",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/docs",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/redoc",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "env": {
    "PYTHONPATH": "frontend/api"
  },
  "functions": {
    "frontend/api/index.py": {
      "maxDuration": 60,
      "memory": 3008,
      "runtime": "python3.9"
    }
  }
}
