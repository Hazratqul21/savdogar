# Backend Vercel Ignore File
# Only include necessary files for deployment

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
ENV/
env/
.pytest_cache/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
tests/
pytest.ini

# Database files
*.db
*.sqlite
*.sqlite3

# Uploads (use cloud storage)
uploads/

# Git
.git/
.gitignore

# Documentation (not needed for runtime)
*.md
docs/

# Alembic & Migrations (run locally, not in serverless)
alembic/
alembic.ini
migrations/

# Temporary/trigger files
*.tmp
*.temp
*.pid
.deploy-trigger
.vercel-trigger
.vercel-updated

# Certs
certs/

# Scripts not needed for deployment
create_admin.py
create_user.py
create_user_via_mcp.py

# Docker (not used in Vercel)
Dockerfile
docker-compose*.yml
.dockerignore

# API test files
api/test.py
api/.vercel-deploy
