{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm install && npm run build",
  "installCommand": "cd frontend && npm install",
  "outputDirectory": "frontend/.next",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "frontend/api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/frontend/api/index.py",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, PATCH, OPTIONS",
        "Access-Control-Allow-Headers": "*"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/frontend/api/index.py",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, PATCH, OPTIONS",
        "Access-Control-Allow-Headers": "*"
      }
    },
    {
      "src": "/api/health/diagnostic",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/api/health",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/health/diagnostic",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/health",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/docs(.*)",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/redoc(.*)",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/frontend/api/index.py"
    },
    {
      "src": "/verify/(.*)",
      "dest": "/frontend/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "functions": {
    "frontend/api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "runtime": "python3.9"
    }
  },
  "env": {
    "PYTHONPATH": "frontend/api"
  }
}
