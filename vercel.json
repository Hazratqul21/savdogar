{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/api/index.py"
    }
  ],
  "functions": {
    "backend/api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "backend/**"
    }
  }
}
